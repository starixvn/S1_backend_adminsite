###
# 取得 Payment Info
# payId帶null可取全部
POST {{url}}/apiV2/BaseData/GetPaymentList HTTP/1.1
Content-Type: application/json

{
    "payId": 20
}


###
# 取得 Bank Info
POST {{url}}/apiV2/BaseData/GetBankInfoOffList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "purpose": 1
}

###
# 取得 CalCode
# currencyId = 0 取全部
# purpose 1: deposit, 2: withdrawal
POST {{url}}/apiV2/BaseData/GetCalCodeList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "purpose": 1
}

###
# CryptoAmount換算上分金額
POST {{url}}/apiV2/Common/CryptoAmountCalculation HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "exchangeRate": 0.225620814,
    "cryptoAmount": 112.810407
}