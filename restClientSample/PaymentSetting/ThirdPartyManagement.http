Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "channelId": 356
}

###
# 更新三方支援銀行狀態
# status: 1=Enable, 2=Disable
POST {{url}}/apiV2/ThirdPartyManagement/SetBankStatus HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "payId": 56,
    "sysId": 1,
    "channelId": 551,
    "status": 2
}

