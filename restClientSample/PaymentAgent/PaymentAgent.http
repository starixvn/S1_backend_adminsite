# localhost
@url=http://localhost:5070

# AdminSite DEV
# @url=http://admin.n88dev.com

###
# Login V2
POST {{url}}/apiV2/Home/Signin HTTP/1.1
Content-Type: application/json

{
    "userName": "admin",
    "userPwd": "1q2w3e4r"
}

###
# 取得 PaymentAgent 下拉選單 
POST {{url}}/apiV2/PaymentAgent/GetSelectList HTTP/1.1
Content-Type: application/json

###
# 取得 PaymentAgentType 選單
POST {{url}}/apiV2/Enum/GetEnumType HTTP/1.1
Content-Type: application/json

{
    "enumName": "PaymentAgentTypeEnum"
}

###
# 取得 PaymentAgentStatus 選單
POST {{url}}/apiV2/Enum/GetEnumType HTTP/1.1
Content-Type: application/json

{
    "enumName": "PaymentAgentStatusEnum"
}

###
# 取得 PaymentAgent 列表
# permission=164, 1
# types[] 帶 null=全部
# status[] 帶 null=全部
# agent.type===1 才顯示編輯下拉選單
# agent.type===1 才顯示建立帳號
POST {{url}}/apiV2/PaymentAgent/GetList HTTP/1.1
Content-Type: application/json

{
    "types": [1],
    "status": [1]
}

###
# 編輯 PaymentAgentStatus
# permission=164, 3
POST {{url}}/apiV2/PaymentAgent/SetStatus HTTP/1.1
Content-Type: application/json

{
    "agentId": 2,
    "status": 0
}

###
# 編輯 PaymentAgent
# permission=164, 3
# agentId=0 為新增
# siteIds 只有新增時可編輯

POST {{url}}/apiV2/PaymentAgent/Set HTTP/1.1
Content-Type: application/json

{
    "agentId": 0,
    "agentName": "AgentName",
    "type": 1,
    "siteIds": [1,2,3],
    "currencyIds": [2,4,51],
    "status": 1
}

###
# 設定 PaymentAgent AdminUser
# permission=164, 92
# userId=0 為新增
POST {{url}}/apiV2/PaymentAgent/SetUser HTTP/1.1
Content-Type: application/json

{
    "userId": 0,
    "agentId": 35,
    "userName": "AgentName_02",
    "password": "1234qwer",
    "siteIds": [1],
    "currencyIds": [3,2,4,51],
    "groupIds": [1,2],
    "status": 1
}

###
# 取得 PaymentAgent 下的 所有AdminUser
# permission=164, 1
POST {{url}}/apiV2/PaymentAgent/GetUserList HTTP/1.1
Content-Type: application/json

{
    "agentId": 35,

}

###
# 取得 PaymentAgent 下的特定 AdminUser
# (回傳內容與 GetUserList 相同，如果用不到跟我說可以刪掉)
# permission=164, 1
POST {{url}}/apiV2/PaymentAgent/GetUser HTTP/1.1
Content-Type: application/json

{
    "agentId": 35,
    "userId": 155
}
