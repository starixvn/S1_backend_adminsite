# localhost
@url=http://localhost:5070

# AdminSite DEV
# @url=http://admin.n88dev.com

###
# Login V2
POST {{url}}/apiV2/Home/Signin HTTP/1.1
Content-Type: application/json

{
    "userName": "admin",
    "userPwd": "1q2w3e4r"
}

###
# 取得OnlinePayment支付渠道列表
POST {{url}}/apiV2/BaseData/GetOnlinePayList HTTP/1.1
Content-Type: application/json

{
    "sysId": 37,
    "currencyId": 2,
    "amount": 2000,
    "custId": 249951
}

###
# 取得 Bank Info
POST {{url}}/apiV2/BaseData/GetBankInfoOffList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "purpose": 2
}

###
# 取得CryptoWallet列表
# 回傳值非空陣列時顯示CryptoWallet選項
POST {{url}}/apiV2/BaseData/GetCryptoWalletList HTTP/1.1
Content-Type: application/json

{
    "purpose": 2,
    "currencyId": 2
}

###
# CryptoWallet 送出
POST {{url}}/apiV2/Withdrawal/SendToNext HTTP/1.1
Content-Type: application/json

{"comment":"","transId":"WD136180","withdrawalInfo":"{\"SysId\": 31, \"IFSCCode\": null, \"AccountNo\": \"54423543\", \"AccountName\": \"test\"}","action":4,"selId":21,"withdrawalType":1}

###
# 取得 CalCode
# currencyId = 0 取全部
# purpose 1: deposit, 2: withdrawal
POST {{url}}/apiV2/BaseData/GetCalCodeList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 0,
    "purpose": 2
}

###
# 取得 Settlement 下拉選單
POST {{url}}/apiV2/BaseData/GetPaymentList HTTP/1.1
Content-Type: application/json

{
    "payId": null,
    "currencyId": 4
}

###
# Settlement 送出PROCESS
# channelId固定帶0
# withdrawalType固定帶6
# selId來源為GetPaymentList選擇的payId
POST {{url}}/apiV2/Withdrawal/SendToNext HTTP/1.1
Content-Type: application/json

{
  "comment": "",
  "transId": "WD137877",
  "withdrawalInfo": "{\"SysId\": 8, \"IFSCCode\": null, \"AccountNo\": \"1123344566789111\", \"AccountName\": \"Hồ thái nhậts\"}",
  "action": 4,
  "selId": 22,
  "withdrawalType": 6,
  "channelId": 0
}
