@using BackendSite.Service.BLL
@inject SelLangBLL selLangBLL
@inject ReportBLL _reportBll

@{
    Layout = "~/Views/Shared/_LayoutReactJs.cshtml";
    ViewData["Title"] = "Withdrawal Limit Management";
}
<link href="~/css/main.css" rel="stylesheet" />
<link href="~/css/page/Marketing.css" rel="stylesheet" asp-append-version="true" />
@{
    var i18n = new Dictionary<string, string>();

    var list = _reportBll.GetCurrency();
    foreach (var data in list)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"CurrencyWithdrawal_{data.CurrencyId}")))
            i18n.Add($"lbl_CurrencyWithdrawal{data.CurrencyId}", string.Format(selLangBLL.GetResourceValue($"CurrencyWithdrawal_{data.CurrencyId}"), data.TimeZone) );
    }

    var lbl_Txts = new string[] { "lbl_Save", "lbl_Success", "lbl_Action", "lbl_SelectSite", "lbl_Point", "lbl_DepositLeast", "lbl_BetLeast", "lbl_AddPointLevel", "lbl_AddNewPointLevel", "lbl_Delete", "lbl_AreYouSure", "lbl_OK", "lbl_Cancel", "lbl_Error" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }
}
<div id="content">
</div>
@section Scripts {
    <script type="text/javascript">
            //$('.collapse').collapse();
            window.i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
        </script>
    <script src="~/js/component/Finance/WithdrawalLimitManagement.min.js" asp-append-version="true"></script>
}