###
# 取得原因列表
# funcKeys | String Array | 全選時請全帶
POST {{url}}/apiV2/Reason/GetList HTTP/1.1
Content-Type: application/json

{
    "funcKeys": ["FunKey/Test"],
    "pageNumber": 1,
    "pageSize": 25
}

###
# 修改原因描述
# id: GetList.id
POST {{url}}/apiV2/Reason/Set HTTP/1.1
Content-Type: application/json

{
    "id": 3,
    "description": "test_msg"
}

###
# 新增原因
