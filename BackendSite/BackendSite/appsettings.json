{
  "ServiceType": "API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/backendsite/backendsite-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 10,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "CORS policy execution successful.",
    "CORS policy execution failed.",
    "No CORS policy found for the specified request",
    "Request origin {origin} does not have permission to access the resource.",
    "Authorization was successful.",
    "Executed ViewResult - view {ViewName} executed in {ElapsedMilliseconds}ms.",
    "Sending file. Request path: '{VirtualPath}'. Physical path: '{PhysicalPath}'",
    "Executing ViewResult, running view {ViewName}.",
    "AuthenticationScheme: {AuthenticationScheme} signed out.",
    "AuthenticationScheme: {AuthenticationScheme} signed in.",
    "AuthenticationScheme: {AuthenticationScheme} was challenged.",
    "Authorization failed.",
    "<!DOCTYPE html",
    "{AuthenticationScheme} was not authenticated. Failure message: {FailureMessage}",
    "Executing {FileResultType}, sending file with download name '{FileDownloadName}'",
    "[Content_Types].xml"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "BalanceTimeoutSecond": 10
}
