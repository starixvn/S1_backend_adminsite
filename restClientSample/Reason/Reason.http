###
# 取得FuncKey清單
POST {{url}}/apiV2/GetAllData/GetFuncKeyAboutReason
Content-Type: application/json

###
# 取得原因列表
# funcKeys | String Array | 全選時請全帶
POST {{url}}/apiV2/Reason/GetList HTTP/1.1
Content-Type: application/json

{
    "funcKeys": ["FunKey/Test"],
    "pageNumber": 1,
    "pageSize": 25
}

###
# 修改原因描述
# id: GetList.id
# 測試時請用 FunKey/Test 這個 key 下的資料
POST {{url}}/apiV2/Reason/Set HTTP/1.1
Content-Type: application/json

{
    "id": 111,
    "description": "test_msg"
}

###
# 新增原因
# 測試時請用 FunKey/Test 這個 key
POST {{url}}/apiV2/Reason/Insert HTTP/1.1
Content-Type: application/json

{
    "funcKey": "FunKey/Test",
    "description": "test_msg2"
}