###
# 取得 Offline 銀行卡設定清單
# purposes，sysIds，vipLevels，pointLevels，supportChannels 這幾項要撈全部請帶空陣列 []
# agent 改為 agentId，沒選帶 0
POST {{url}}/apiV2/BankCardManagement/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "purposes": [],
    "statuses": [0, 1, 2, 3, 4],
    "sysIds": [],
    "vipLevels": [],
    "pointLevels": [],
    "accountNo": "",
    "agentId": 28,
    "supportChannels": [1],
    "pageNumber": 1,
    "pageSize": 25
}

###
# Offline 銀行卡設定
POST {{url}}/apiV2/BankCardManagement/Set HTTP/1.1
Content-Type: application/json

{
    "financialAccountId": 68,
    "siteId": 1,
    "currencyId": 2,
    "minAmount": 20,
    "maxAmount": 50000,
    "dailyLimitAmount": 100000,
    "vipLevels": [1, 2, 3, 4, 5,6],
    "pointLevels": [0, 1, 2, 3, 4, 5, 6, 7],
    "memo": "test",
    "sort": 0,
    "status": 1,
    "supportChannels": [0, 1],
    "qrCodeUrl": "/pay-qrcode/1678965098.jpg",
    "groupIds": [31,17,26]
}


