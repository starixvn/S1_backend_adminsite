###
# 取得支付三方設定列表
# currencyIds | Number Array | 
# method | Number | Nullable | 帶 null 可取全部
# payId | Number | Nullable | 帶 null 可取全部
# type | Number | Nullable | 帶 null 可取全部
# payStatus | Number | Nullable | 帶 null 可取全部
# status | Number | Nullable | 帶 null 可取全部
POST {{url}}/apiV2/ThirdPartyManagement/GetPaySettingList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2, 4, 15, 51, 61],
    "method": 1,
    "payId": null,
    "type": null,
    "globalStatus": null,
    "status": null,
    "pageNumber": 1,
    "pageSize": 10
}

###
# 支付三方設定
# fixedAmountList | Number Array | Nullable | amountRule=3 時才要帶
POST {{url}}/apiV2/ThirdPartyManagement/SetPaySetting HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 4,
    "channelId": 1,
    "minAmount": 50,
    "maxAmount": 10000,
    "amountRule": 1,
    "fixedAmountList": null,
    "pointLevel": 2,
    "sort": 3
}

###
# 支付三方狀態設定
POST {{url}}/apiV2/ThirdPartyManagement/SetPaySettingStatus HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 4,
    "channelId": 1,
    "status": 2
}

###
# 支付三方手續費設定
POST {{url}}/apiV2/ThirdPartyManagement/SetPaySettingChargeFee HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "channelId": 9,
    "percentage": 2,
    "preCount": 10
}

###
# 取得渠道支援的銀行
