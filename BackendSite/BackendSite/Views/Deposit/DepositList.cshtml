@model IEnumerable<DepositRequest>
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@using BackendSite.Service.Model
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@{
    Layout = "~/Views/Shared/_LayoutReactJs.cshtml";
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_DepositRequest");
}
<h1>@selLangBLL.GetResourceValue("lbl_DepositRequest")</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_TransId")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_UserName")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_DepositType")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_AccountNo")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_AccountName")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_Amount")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_Memo")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_Postscript")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_CreateTime")</th>
            <th scope="col">@selLangBLL.GetResourceValue("lbl_Status")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var bank = ((DepositInfo3_1)item.depositInfo);
            <tr>
                <th scope="row">@Html.ActionLink(@item.TransId, "DepositRequest", "Deposit", new { transID = @item.TransId })</th>
                <td>@item.UserName</td>
                <td>@item.DepositTypeString</td>
                <td>@bank.AccountNo</td>
                <td>@bank.AccountName</td>
                <td>@item.Amount</td>
                <td>@item.Memo</td>
                <td>@item.PostScript</td>
                <td>@item.CreateTime</td>
                <td>@item.StatusString</td>
            </tr>
        }
    </tbody>
</table>
