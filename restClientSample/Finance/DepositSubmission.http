###
# 取得 BankCard 列表
# sabaId, userName 擇一填寫
# purpose: 1.Deposit, 2.withdrawal，這邊帶 1 即可
# 請根據選擇的 bank card status 篩選 settingStatus 聯動下拉選單
POST {{url}}/apiV2/BaseData/GetBankInfoOffListByCustVerify HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "sabaId": "",
    "userName": "anisetestmyr01",
    "purpose": 1
}

