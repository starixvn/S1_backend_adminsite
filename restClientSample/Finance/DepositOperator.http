###
# 取得 Payment Info
# payId帶null可取全部
POST {{url}}/apiV2/BaseData/GetPaymentList HTTP/1.1
Content-Type: application/json

{
    "payId": 20
}


###
# 取得 Bank Info
POST {{url}}/apiV2/BaseData/GetBankInfoOffList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "purpose": 1
}

###
# 取得 CalCode
# currencyId = 0 取全部
# purpose 1: deposit, 2: withdrawal
POST {{url}}/apiV2/BaseData/GetCalCodeList HTTP/1.1
Content-Type: application/json

{
    "currencyId": 2,
    "purpose": 1
}

###
# CryptoAmount換算上分金額
POST {{url}}/apiV2/Common/CryptoAmountCalculation HTTP/1.1
Content-Type: application/json

{
    "currencyId": 51,
    "exchangeRate": 0.00004259219480519481,
    "cryptoAmount": 3.5
}


###
# CryptoWallet Approved，新增欄位 actualCryptoAmount
POST {{url}}/apiV2/Deposit/SendToNext HTTP/1.1
Content-Type: application/json

{
    "action": 3,
    "actualDeposit": 82174.0,
    "comment": "",
    "transId": "DD1405333",
    "actualCryptoAmount": 3.5
}

