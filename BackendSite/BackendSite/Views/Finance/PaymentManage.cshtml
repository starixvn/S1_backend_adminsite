@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using BackendSite.Service.BLL
@using BackendSite.Service.DAL
@using Newtonsoft.Json
@inject AuthorizeBLL authorizeBLL
@inject AdminUserService adminUserService
@inject PermissionBLL permissionBLL
@section Style {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
}
@{
    Layout = "~/Views/Shared/_LayoutOneLab.cshtml";
    ViewData["Title"] = "Payment Management";
}
@{
    var authData = authorizeBLL.GetAuthData();
    var loginUser = adminUserService.GetUser(authData.UserId);

    IEnumerable<string> subFuncKeys = permissionBLL.GetSubFunckeys("Finance/PaymentManage");
    subFuncKeys = subFuncKeys == null ? new List<string>() : subFuncKeys;
}

<div id="content"></div>


@section Scripts {
    <script>
        window.RootUrl = '@Url.Content("~/api")';
        window.LangCode = 'en'
        window.subFuncKeys = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(subFuncKeys));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/js/component/Finance/PaymentManagement.min.js" asp-append-version="true"></script>
}