###
# 取得轉帳帳戶列表
# purposes | 搜尋全部時傳空陣列
# sysIds | 搜尋全部時請傳空陣列
# agent 改為 agentId，沒選帶 0
POST {{url}}/apiV2/BankTransferAccount/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2, 4, 15, 51],
    "channels": [1, 2, 3, 6],
    "agentId": 28,
    "status": [0, 1, 2, 3],
    "purposes": [],
    "sysIds": [],
    "accountNo": ""
}

###
# 匯出轉帳帳戶列表
# purposes | 搜尋全部時傳空陣列
# sysIds | 搜尋全部時請傳空陣列
# agent 改為 agentId，沒選帶 0
POST {{url}}/apiV2/BankTransferAccount/Export HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2, 4, 15, 51],
    "channels": [1, 2, 3, 6],
    "agentId": 0,
    "status": [0, 1, 2, 3],
    "purposes": [],
    "sysIds": [],
    "accountNo": ""
}

###
# 取得轉帳帳戶資訊
POST {{url}}/apiV2/BankTransferAccount/GetById HTTP/1.1
Content-Type: application/json

{
    "id": 511
}

###
# 取得轉帳帳戶原因(?)
POST {{url}}/apiV2/BankTransferAccount/GetTransferAccountReason HTTP/1.1
Content-Type: application/json


###
# 新增(Id=0)/更新轉帳帳戶資訊
# accountCode 現在只 for INR IFSC.使用
# channel 為 LocalBank 時 accountNo 為必填且只能填入數字，其他 channel 不限制
# purposes 在 channel 為 6(CryptoWallet) 時只能選擇 2(Withdrawal)、3(Transfer)
# payId 在 channel 為 3(PSP) 時才必填
# sysId 在 channel 為 1(LocalBank) 時才必填
# cryptoCurrencyId、network在 channel 為 6(CryptoWallet)時必填
# agent 改為 agentId，沒選帶 0
# bankLoginAccount，bankLoginPassword 改為 bankLoginInfo[]
POST {{url}}/apiV2/BankTransferAccount/Set HTTP/1.1
Content-Type: application/json

{
    "id": 511,
    "siteId": 1,
    "currencyId": 2,
    "sysId": null,
    "purposes": [2,3],
    "channel": 6,
    "agentId": 28,
    "payId": null,
    "cryptoCurrencyId": 96,
    "network": "ETH",
    "accountNo": "ETH-0x23E717D9401C96cD987fCc746Ed998de83f15Ccf",
    "accountName": "ATest",
    "accountCode": "",
    "displayName": "Nova88-MYR-ATest-ETH-5Ccf",
    "frontendDisplayName": "0x23E717D9401C96cD987fCc746Ed998de83f15Ccf",
    "initialAmount": 0,
    "initialTime": "2022-11-01T00:00:00+08:00",
    "maxBalanceAlertAmount": 0,
    "reason": 1,
    "remark": null,
    "status": 2,
    "bankLoginUrl": "",
    "bankLoginInfo": [{
        "account": "test1234",
        "password": "1234qwer"
    }],
    "transferPin": "",
    "loginPin": "",
    "mobilePin": "",
    "corporateID": ""
}

