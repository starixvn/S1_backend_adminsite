@model IEnumerable<BackendSite.Service.Model.BankDetail>
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@using Newtonsoft.Json
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@section Style {
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700|Poppins&display=swap" rel="stylesheet">
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
}
@{
    Layout = "~/Views/Shared/_LayoutReactJs.cshtml";
    ViewData["Title"] = "Payment Adjustment";
}
@{
    var i18n = new Dictionary<string, string>();
    var lbl_Txts = new string[] { "lbl_Enable", "lbl_Disable" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    //var serverInfo = serverInfoBLL.GetServerInfo();

    for (var currency = 1; currency <= 74; currency++)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"Currency_{currency}")))
            i18n.Add($"lbl_Currency{currency}", selLangBLL.GetResourceValue($"Currency_{currency}"));
    }
}
<h4 class="page-name">Balance Adjustment</h4>
<div id="App"></div>
@section Scripts {
    <script>
        $.extend(i18n, @Html.Raw(JsonConvert.SerializeObject(i18n)));
    </script>
    <script src="~/lib/runtime.min.js"></script>
    <script src="~/js/component/Finance/PaymentAdjustment.min.js" asp-append-version="true"></script>
}