Content-Type: application/json

{
    "financialAccountId": 511,
    "siteId": 1,
    "currencyId": 2,
    "minAmount": 1000,
    "maxAmount": 50000,
    "dailyLimitAmount": 100000,
    "vipLevels": [1, 2, 3, 4, 5],
    "pointLevels": [1, 2, 3, 4, 5],
    "memo": "test",
    "sort": 0,
    "status": 1,
    "supportChannels": [],
    "qrCodeUrl": ""
}

