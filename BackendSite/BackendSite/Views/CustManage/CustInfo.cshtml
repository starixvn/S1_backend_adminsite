@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject PermissionBLL permissionBLL
@section Style {
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700|Poppins&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.7.1/css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.2/css/all.css">
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/page/CusInfo.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/vendor/DateTimePicker/DateTimePicker.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-multiselect/bootstrap-multiselect-modify.css" rel="stylesheet" />
}
@{
    ViewData["Title"] = $"{ViewContext.HttpContext.Request.Query["UserName"]}";
    Layout = "~/Views/Shared/_LayoutReactJs.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    for (var currency = 1; currency <= 51; currency++)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"Currency_{currency}")))
            i18n.Add($"lbl_Currency{currency}", selLangBLL.GetResourceValue($"Currency_{currency}"));
    }

    for (int i = 0; i <= 7; i++)
    {
        if (!i18n.ContainsKey($"lbl_DepositStatus{i}"))
            i18n.Add($"lbl_DepositStatus{i}", selLangBLL.GetResourceValue($"lbl_DepositStatus{i}"));
    }
    i18n.Add($"lbl_DepositStatus{99}", selLangBLL.GetResourceValue($"lbl_DepositStatus{99}"));

    for (int i = 1; i <= 3; i++)
    {
        if (!i18n.ContainsKey($"lbl_DepositType{i}"))
            i18n.Add($"lbl_DepositType{i}", selLangBLL.GetResourceValue($"lbl_DepositType{i}"));
    }

    for (int i = 0; i <= 7; i++)
    {
        if (!i18n.ContainsKey($"lbl_WithdrawalStatus{i}"))
            i18n.Add($"lbl_WithdrawalStatus{i}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{i}"));
    }
    i18n.Add($"lbl_WithdrawalStatus{99}", selLangBLL.GetResourceValue($"lbl_WithdrawalStatus{99}"));

    for (int i = 0; i <= 2; i++)
    {
        if (!i18n.ContainsKey($"lbl_WithdrawalType{i}"))
            i18n.Add($"lbl_WithdrawalType{i}", selLangBLL.GetResourceValue($"lbl_WithdrawalType{i}"));
    }

    IEnumerable<string> subFuncKeys = permissionBLL.GetSubFunckeys("CustManage/CustInfoList");
    subFuncKeys = subFuncKeys == null ? new List<string>() : subFuncKeys;
}
@section Scripts {
    <script src="~/lib/clipboard.min.js"></script>
    <script src="~/lib/bootstrap-multiselect/bootstrap-multiselect.js"></script>
    <script type="text/javascript">
        $.extend(i18n, @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n)));
        var subFuncKeys = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(subFuncKeys));
    </script>
    <script src="~/js/component/CustManage/CustInfo.min.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.7.1/js/bootstrap-datepicker.min.js"></script>
}
