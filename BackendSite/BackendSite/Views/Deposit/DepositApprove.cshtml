
@{
    ViewData["Title"] = "DepositApprove";
}

<script src="~/lib/axios.min.js" asp-append-version="true"></script>


<h1>DepositApprove</h1>



<div>Trans ID: @Model.TransId</div>
<div>User Name: @Model.UserName</div>
<div>Deposit Type: @Model.DispositType</div>
<div>Amount: @Model.Amount</div>
<div>
    Actual Deposit:  <input type="text" id="actualdeposit" value="@Model.ActualDeposit" />
    <div>Memo: @Model.Memo</div>
    <div>Post Script: @Model.PostScript</div>
    <div>Create Time: @Model.CreateTime</div>

    <div>
        <textarea id="command" name="command"
                  rows="5" cols="33"></textarea>
    </div>

    <input type='button' onclick='UpdateStatus(1)' value='Approve'>
    <input type='button' onclick='UpdateStatus(2)' value='Reject'>
    <input type='button' onclick='UpdateStatus(3)' value='Command'>


    <script type="text/javascript">
    function UpdateStatus(Status) {
            let data = { "TransId": "@Model.TransId", "Action": Status, "ActualDeposit": parseFloat($("#actualdeposit").val()), "Command": $("#command").val() };
            axios.post('/Deposit/DepositConfirm', data)
                .then(function (response) {
                    console.log(response.data);
                    let result = response.data;
                    if (result.errorCode == 0) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                }).catch(function (error) {
                    alert(error);
                });
      }
    </script>
