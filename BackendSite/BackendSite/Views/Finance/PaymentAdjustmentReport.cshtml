@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@using BackendSite.Service.Model.enums
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@section Style {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/Oneworks/jscalendar/calendar-blue.css" rel="stylesheet" />
}
@{
    Layout = "~/Views/Shared/_LayoutPagesApp.cshtml";
    ViewData["Title"] = "Payment Adjustment Report";
}
@{
    var currencyList = serverInfoBLL.GetCurrencyList();
    var i18n = new Dictionary<string, string>();

    foreach (var currency in currencyList)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"Currency_{currency}")))
            i18n.Add($"lbl_Currency{currency}", selLangBLL.GetResourceValue($"Currency_{currency}"));
    }

    var adjustType = new Dictionary<int, string>();
    foreach (var value in Enum.GetValues(typeof(AdjustTypeEnum)))
    {
        var _value = (int)value;
        adjustType.Add(_value, selLangBLL.GetResourceValue($"lbl_AdjustmentType{_value}") ?? _value.ToString());        
    }
}

<div id="content"></div>


@section Scripts {  
    <script>
        window.i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
        window.RootUrl = '@Url.Content("~/api")';
        window.LangCode = 'en'
        window.gCurrencyList = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currencyList));
        window.gAdjustTypeList = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(adjustType));
    </script>
    <script src="~/lib/Oneworks/jscalendar/calendar.js"></script>
    <script src="~/lib/Oneworks/jscalendar/lang/calendar-en.js"></script>
    <script src="~/lib/Oneworks/jscalendar/calendar-setup.js"></script>
    <script src="~/js/component/Finance/PaymentAdjustmentReport.min.js" asp-append-version="true"></script>
}