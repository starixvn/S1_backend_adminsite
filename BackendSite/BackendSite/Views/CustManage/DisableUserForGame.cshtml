@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject PermissionBLL permissionBLL
@section Style {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/Oneworks/jscalendar/calendar-blue.css" rel="stylesheet" />
    <link href="~/css/vendor/DateTimePicker/DateTimePicker.css" rel="stylesheet" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Disable User For Game";
    Layout = "~/Views/Shared/_LayoutPagesApp.cshtml";
}
@{
    var i18n = new Dictionary<string, string>();
    for (var currency = 1; currency <= 74; currency++)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"Currency_{currency}")))
            i18n.Add($"lbl_Currency{currency}", selLangBLL.GetResourceValue($"Currency_{currency}"));
    }
}
<div id="content"></div>
@section Scripts {
    <script>
        window.i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
        window.RootUrl = '@Url.Content("~/api")';
        window.LangCode = 'en'
    </script>
    <script src="~/lib/Oneworks/jscalendar/calendar.js"></script>
    <script src="~/lib/Oneworks/jscalendar/lang/calendar-en.js"></script>
    <script src="~/lib/Oneworks/jscalendar/calendar-setup.js"></script>
    <script src="~/js/component/CSD/DisableUserForGame.min.js" asp-append-version="true"></script>
}