###
# 取得報表
# channel | number array | nullable | 撈全部請帶null
# agents | int array | nullable | 撈全部請帶null => string array 改為 int array
# financialAccountId | number array | nullable | 撈全部請帶null
POST {{url}}/apiV2/BankFinancialReport/Get HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2,4,15,51,61],
    "startTime": "2022-08-01T00:00:00+08:00",
    "endTime": "2022-08-31T00:00:00+08:00",
    "channel": null,
    "agents": [28],
    "financialAccountIds": null
}

###
# 匯出報表
# agents => string array 改為 int array
POST {{url}}/apiV2/BankFinancialReport/Export HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2,4,15,51,61],
    "startTime": "2023-08-01T00:00:00+08:00",
    "endTime": "2023-09-01T00:00:00+08:00",
    "channel": null,
    "agents": [28],
    "financialAccountIds": null
}


