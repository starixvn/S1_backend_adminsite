@model IEnumerable<WithdrawalRequest>
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@using BackendSite.Service.Model
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@{
    Layout = null;
    ViewData["Title"] = @selLangBLL.GetResourceValue("lbl_WithdrawalRequest");
}
@{
    var i18n = new Dictionary<string, string>();
    i18n.Add("lbl_Currency2", selLangBLL.GetResourceValue("Currency_2"));
    i18n.Add("lbl_Currency4", selLangBLL.GetResourceValue("Currency_4"));
    i18n.Add("lbl_Currency15", selLangBLL.GetResourceValue("Currency_15"));
    i18n.Add("lbl_Currency51", selLangBLL.GetResourceValue("Currency_51"));
    i18n.Add("lbl_Pending", selLangBLL.GetResourceValue("lbl_Pending"));
    i18n.Add("lbl_Approved", selLangBLL.GetResourceValue("lbl_Approved"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BackendSite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <h1>@selLangBLL.GetResourceValue("lbl_WithdrawalRequest")</h1>
    <hr />
    <div class="container-fluid">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_WithdrawalId")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_WithdrawalType")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_UserName")</th>
                    <th scope="col">WithdrawalInfo</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_Amount")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_ChargeFee")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_Memo")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_CreateTime")</th>
                    <th scope="col">@selLangBLL.GetResourceValue("lbl_Status")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@Html.ActionLink(@item.TransId, "WithdrawalRequest", "Withdrawal", new { transID = @item.TransId })</th>
                        <td>@item.WithdrawalType</td>
                        <td>@item.UserName</td>
                        <td>@item.WithdrawalInfo</td>
                        <td>@item.Amount</td>
                        <td>@item.ChargeFee</td>
                        <td>@item.Memo</td>
                        <td>@item.CreateTime</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
    <script>
        var i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
    </script>
    @if (environment.EnvironmentName == "Development")
    {
        <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha256-pasqAKBDmFT4eHoN2ndd6lN370kFiGUFyTiUHWhU7k8=" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/react@16/umd/react.development.js"></script>
        <script src="https://unpkg.com/react-dom@16/umd/react-dom.development.js"></script>
        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/6.26.0/babel.js"></script>
    }
    else
    {

    }
</body>
</html>
