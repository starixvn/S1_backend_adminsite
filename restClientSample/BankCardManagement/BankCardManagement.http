###
# 取得 Offline 銀行卡設定清單
# purposes，sysIds，vipLevels，pointLevels，supportChannels 這幾項要撈全部請帶空陣列 []
POST {{url}}/apiV2/BankCardManagement/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "purposes": [],
    "statuses": [0, 1, 2, 3, 4],
    "sysIds": [],
    "vipLevels": [],
    "pointLevels": [],
    "accountNo": "0x23E717D9401C96cD987fCc746Ed998de83f15Ccf",
    "agent": "",
    "supportChannels": [],
    "pageNumber": 1,
    "pageSize": 10
}

###
# Offline 銀行卡設定
