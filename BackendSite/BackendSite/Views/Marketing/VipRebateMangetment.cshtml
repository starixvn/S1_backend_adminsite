@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Hosting
@using BackendSite.Service.BLL
@using BackendSite.Service.Model.enums
@inject IWebHostEnvironment environment
@inject SelLangBLL selLangBLL
@inject ServerInfoBLL serverInfoBLL
@inject AuthorizeBLL authorizeBLL
@inject PermissionBLL permissionBLL
@section Style {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/main.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap-multiselect/bootstrap-multiselect-modify.css" rel="stylesheet" />
    <link href="~/css/vendor/DateTimePicker/DateTimePicker.css" rel="stylesheet" />
}
@{
    Layout = "~/Views/Shared/_LayoutPagesApp.cshtml";
    ViewData["Title"] = "Vip Rebate Mangetment";
}
@{
    var i18n = new Dictionary<string, string>();
    var lbl_Txts = new string[] { "lbl_Save", "lbl_Success", "lbl_Action", "lbl_SelectSite", "lbl_Point", "lbl_DepositLeast", "lbl_BetLeast", "lbl_AddPointLevel", "lbl_AddNewPointLevel", "lbl_Delete", "lbl_AreYouSure", "lbl_OK", "lbl_Cancel", "lbl_Error" };
    foreach (var lbl_Txt in lbl_Txts)
    {
        if (!i18n.ContainsKey(lbl_Txt))
            i18n.Add(lbl_Txt, selLangBLL.GetResourceValue(lbl_Txt));
    }

    var currencyList = serverInfoBLL.GetCurrencyList();
    foreach (var currency in currencyList)
    {
        if (!string.IsNullOrEmpty(selLangBLL.GetResourceValue($"Currency_{currency}")))
            i18n.Add($"lbl_Currency{currency}", selLangBLL.GetResourceValue($"Currency_{currency}"));
    }

    var subFuncKeys = permissionBLL.GetSubFunckeys("Marketing/VipRebateMangetment");
    subFuncKeys = subFuncKeys == null ? new List<string>() : subFuncKeys;
}

<div id="content"></div>


@section Scripts {
    <script>
        window.i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(i18n));
        window.RootUrl = '@Url.Content("~/api")';
        window.LangCode = 'en';
        window.subFuncKeys = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(subFuncKeys));
    </script>
    <script src="~/lib/bootstrap-multiselect/bootstrap-multiselect.js"></script>
    <script src="~/js/component/Marketing/VipRebateMangetment.min.js" asp-append-version="true"></script>
}